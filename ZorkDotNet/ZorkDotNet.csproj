<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Exclude nested test folder if present (tests live in repo-root ZorkDotNet.Tests) -->
    <Compile Remove="ZorkDotNet.Tests\**" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ZorkDotNet</RootNamespace>
    <AssemblyName>Zork</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- Native AOT: release builds are native executables (no JIT, no runtime to ship). linux-arm (32-bit) is the
         exception, since AOT does not support it; CI publishes it trimmed single-file instead. -->
    <PublishAot>true</PublishAot>
    <!-- The full-screen interface turns on ANSI output in the Windows console with LibraryImport (source-generated P/Invoke). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests check the save model (GameSave.Capture) directly. -->
    <InternalsVisibleTo Include="ZorkDotNet.Tests" />
  </ItemGroup>

</Project>
